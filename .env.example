# docker inspect <sub2api-container> --format '{{json .NetworkSettings.Networks}}'
SUB2API_NETWORK=replace-with-your-existing-network
# File paths only; never paste credentials into this file or Docker build arguments.
MIRASIM_CREDENTIAL_FILE=./private/setting.json
SUB2API_ADMIN_KEY_FILE=./private/admin-key
NODE_IMAGE=node:22-bookworm-slim
